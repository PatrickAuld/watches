<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="ANALOG" />
  <Metadata key="PREVIEW_TIME" value="10:10:00" />
  <Scene backgroundColor="#050607">
    <Group x="0" y="0" width="450" height="450" name="engraved_dial">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <PartImage x="0" y="0" width="450" height="450"><Image resource="dial" /></PartImage>
      <Group x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" name="moving_plate">
        <Transform target="angle" value="[SECOND_MILLISECOND] * 1.125" />
        <PartImage x="0" y="0" width="450" height="450"><Image resource="plate" /></PartImage>
      </Group>
      <Group x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" name="slow_moving_plate">
        <Transform target="angle" value="([MINUTES_SINCE_EPOCH] % 800) * 0.45 + [SECOND_MILLISECOND] * 0.0075" />
        <PartImage x="0" y="0" width="450" height="450"><Image resource="slow_plate" /></PartImage>
      </Group>
    </Group>

    <Group x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" name="hour_interference">
      <Transform target="angle" value="([HOUR_0_23] % 12) * 30 + [MINUTE_SECOND] * 0.5" />
      <PartImage x="0" y="0" width="450" height="450" renderMode="SOURCE"><Image resource="hour_engraving" /></PartImage>
      <Group x="0" y="0" width="450" height="450" renderMode="MASK" name="hour_slit_plate">
        <Group x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" name="hour_plate_registration">
          <Transform target="angle" value="[SECOND_MILLISECOND] * 1.125 - (([HOUR_0_23] % 12) * 30 + [MINUTE_SECOND] * 0.5)" />
          <PartImage x="0" y="0" width="450" height="450"><Image resource="slit" /></PartImage>
        </Group>
      </Group>
      <Group x="0" y="0" width="450" height="450" renderMode="MASK" name="hour_slow_veil">
        <Group x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" name="hour_slow_registration">
          <Transform target="angle" value="([MINUTES_SINCE_EPOCH] % 800) * 0.45 + [SECOND_MILLISECOND] * 0.0075 - (([HOUR_0_23] % 12) * 30 + [MINUTE_SECOND] * 0.5)" />
          <PartImage x="0" y="0" width="450" height="450"><Image resource="slow_veil" /></PartImage>
        </Group>
      </Group>
    </Group>

    <Group x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" name="minute_interference">
      <Transform target="angle" value="[MINUTE_SECOND] * 6" />
      <PartImage x="0" y="0" width="450" height="450" renderMode="SOURCE"><Image resource="minute_engraving" /></PartImage>
      <Group x="0" y="0" width="450" height="450" renderMode="MASK" name="minute_slit_plate">
        <Group x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" name="minute_plate_registration">
          <Transform target="angle" value="[SECOND_MILLISECOND] * 1.125 - [MINUTE_SECOND] * 6" />
          <PartImage x="0" y="0" width="450" height="450"><Image resource="slit" /></PartImage>
        </Group>
      </Group>
      <Group x="0" y="0" width="450" height="450" renderMode="MASK" name="minute_slow_veil">
        <Group x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" name="minute_slow_registration">
          <Transform target="angle" value="([MINUTES_SINCE_EPOCH] % 800) * 0.45 + [SECOND_MILLISECOND] * 0.0075 - [MINUTE_SECOND] * 6" />
          <PartImage x="0" y="0" width="450" height="450"><Image resource="slow_veil" /></PartImage>
        </Group>
      </Group>
    </Group>

    <PartDraw x="0" y="0" width="450" height="450">
      <Ellipse x="220" y="220" width="10" height="10"><Fill color="#e6d1a9" /></Ellipse>
      <Ellipse x="223" y="223" width="4" height="4"><Fill color="#231d16" /></Ellipse>
    </PartDraw>
  </Scene>
</WatchFace>
