<!-- Generated by generate_xml.py; edit that instead. -->
<WatchFace width="450" height="450" clipShape="CIRCLE">
  <Metadata key="CLOCK_TYPE" value="ANALOG" />
  <Metadata key="PREVIEW_TIME" value="10:26:40" />
  <UserConfigurations>
    <ColorConfiguration id="palette" displayName="palette" defaultValue="scratchboard">
      <ColorOption id="scratchboard" displayName="palette_scratchboard" colors="#FF000000 #FFEDE4D3 #FFFF6A2E" />
      <ColorOption id="silverpoint" displayName="palette_silverpoint" colors="#FF000000 #FFC8D2DC #FFFFB830" />
      <ColorOption id="sepia" displayName="palette_sepia" colors="#FF000000 #FFD8A66A #FFFF4A3A" />
      <ColorOption id="cyanotype" displayName="palette_cyanotype" colors="#FF000000 #FF73B9FF #FFFFAE3A" />
      <ColorOption id="vermilion" displayName="palette_vermilion" colors="#FF000000 #FFFF6A55 #FFFFE066" />
    </ColorConfiguration>
  </UserConfigurations>
  <Scene backgroundColor="#000000">

    <!-- Ground: one family of "/" hatching over the whole board. -->
    <Group x="0" y="0" width="450" height="450" name="ground">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <PartImage x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.palette.1]"><Image resource="crosshatch_ground" /></PartImage>
    </Group>

    <!-- Countdown: crosshatch from the minute line forward to the next
         :00 or :30. It narrows to nothing as the meeting arrives. -->
    <Group x="0" y="0" width="450" height="450" name="countdownAmbient">
    <Variant mode="AMBIENT" target="alpha" value="0" />
    <Group x="0" y="0" width="450" height="450" name="countdown">
      <PartImage x="0" y="0" width="450" height="450" renderMode="SOURCE" tintColor="[CONFIGURATION.palette.1]"><Image resource="crosshatch_sector" /></PartImage>
      <Group x="0" y="0" width="450" height="450" renderMode="MASK" name="countdownMask">
        <PartDraw x="0" y="0" width="450" height="450">
          <Arc centerX="225" centerY="225" width="226" height="226" startAngle="0" endAngle="180">
            <Transform target="startAngle" value="([MINUTE] * 6 + [SECOND] * 0.1)" />
            <Transform target="endAngle" value="(([MINUTE] &lt; 30) ? 180 : 360)" />
            <Stroke color="#FFFFFFFF" thickness="228" cap="BUTT" />
          </Arc>
        </PartDraw>
      </Group>
    </Group>
    </Group>

    <!-- Warm-up: over the last 5 minutes the whole board warms to the
         accent colour, pulsing faster as the gate closes, building to the flash. -->
    <Group x="0" y="0" width="450" height="450" name="warmupAmbient">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Group x="0" y="0" width="450" height="450" name="warmup">
        <Transform target="alpha" value="255 * 0.85 * pow(clamp((5 - (30 - (([MINUTE] % 30) + [SECOND] / 60))) / 5, 0, 1), 1.25) * (0.62 + 0.38 * sin((([SECOND] + [MILLISECOND] / 1000) * (3.14159 + 9.4 * pow(clamp((5 - (30 - (([MINUTE] % 30) + [SECOND] / 60))) / 5, 0, 1), 1.25)))))" />
        <PartImage x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.palette.2]"><Image resource="crosshatch_ground" /></PartImage>
        <PartImage x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.palette.2]"><Image resource="crosshatch_sector" /></PartImage>
      </Group>
    </Group>

    <!-- Run-up: over the last 5 minutes the remaining wedge heats to
         the accent colour and pulses faster as the gate closes. -->
    <Group x="0" y="0" width="450" height="450" name="runupAmbient">
    <Variant mode="AMBIENT" target="alpha" value="0" />
    <Group x="0" y="0" width="450" height="450" name="runup">
      <Transform target="alpha" value="255 * pow(clamp((5 - (30 - (([MINUTE] % 30) + [SECOND] / 60))) / 5, 0, 1), 1.25) * (0.62 + 0.38 * sin((([SECOND] + [MILLISECOND] / 1000) * (3.14159 + 9.4 * pow(clamp((5 - (30 - (([MINUTE] % 30) + [SECOND] / 60))) / 5, 0, 1), 1.25)))))" />
      <PartImage x="0" y="0" width="450" height="450" renderMode="SOURCE" tintColor="[CONFIGURATION.palette.2]"><Image resource="crosshatch_sector" /></PartImage>
      <Group x="0" y="0" width="450" height="450" renderMode="MASK" name="runupMask">
        <PartDraw x="0" y="0" width="450" height="450">
          <Arc centerX="225" centerY="225" width="226" height="226" startAngle="0" endAngle="180">
            <Transform target="startAngle" value="([MINUTE] * 6 + [SECOND] * 0.1)" />
            <Transform target="endAngle" value="(([MINUTE] &lt; 30) ? 180 : 360)" />
            <Stroke color="#FFFFFFFF" thickness="228" cap="BUTT" />
          </Arc>
        </PartDraw>
      </Group>
    </Group>
    </Group>

    <!-- Gate flash: at :00 and :30 the whole board crosshatches in the
         accent colour and fades over 2 minutes. -->
    <Group x="0" y="0" width="450" height="450" name="burstAmbient">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Group x="0" y="0" width="450" height="450" name="burst">
        <Transform target="alpha" value="255 * pow(clamp(1 - (([MINUTE] % 30) + [SECOND] / 60) / 2, 0, 1), 2)" />
        <PartImage x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.palette.2]"><Image resource="crosshatch_ground" /></PartImage>
        <PartImage x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.palette.2]"><Image resource="crosshatch_sector" /></PartImage>
      </Group>
    </Group>

    <!-- Indices: engraved stroke bundles on clean black reserves.
         12 and 6 are the larger :00 and :30 gates. -->
    <Group x="0" y="0" width="450" height="450" name="indices">
      <Variant mode="AMBIENT" target="alpha" value="150" />
      <PartImage x="0" y="0" width="450" height="450"><Image resource="crosshatch_reserve" /></PartImage>
      <PartImage x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.palette.1]"><Image resource="crosshatch_indices" /></PartImage>
    </Group>

    <!-- The gate being approached glows with the run-up. -->
    <Group x="0" y="0" width="450" height="450" name="gateAmbient">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Group x="0" y="0" width="450" height="450" name="gate" pivotX="0.5" pivotY="0.5">
        <Transform target="angle" value="(([MINUTE] &lt; 30) ? 180 : 0)" />
        <Transform target="alpha" value="255 * pow(clamp((5 - (30 - (([MINUTE] % 30) + [SECOND] / 60))) / 5, 0, 1), 1.25) * (0.62 + 0.38 * sin((([SECOND] + [MILLISECOND] / 1000) * (3.14159 + 9.4 * pow(clamp((5 - (30 - (([MINUTE] % 30) + [SECOND] / 60))) / 5, 0, 1), 1.25)))))" />
        <PartImage x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.palette.2]"><Image resource="crosshatch_gate" /></PartImage>
      </Group>
    </Group>

    <!-- Rim countdown arc: also the whole countdown in ambient. -->
    <Group x="0" y="0" width="450" height="450" name="rim">
      <PartDraw x="0" y="0" width="450" height="450" name="rimInk">
        <Arc centerX="225" centerY="225" width="438" height="438" startAngle="0" endAngle="180">
          <Transform target="startAngle" value="([MINUTE] * 6 + [SECOND] * 0.1)" />
          <Transform target="endAngle" value="(([MINUTE] &lt; 30) ? 180 : 360)" />
          <Stroke color="[CONFIGURATION.palette.1]" thickness="3" cap="ROUND" />
        </Arc>
      </PartDraw>
      <PartDraw x="0" y="0" width="450" height="450" name="rimHeat">
        <Transform target="alpha" value="255 * clamp(pow(clamp((5 - (30 - (([MINUTE] % 30) + [SECOND] / 60))) / 5, 0, 1), 1.25) * 1.4, 0, 1)" />
        <Arc centerX="225" centerY="225" width="438" height="438" startAngle="0" endAngle="180">
          <Transform target="startAngle" value="([MINUTE] * 6 + [SECOND] * 0.1)" />
          <Transform target="endAngle" value="(([MINUTE] &lt; 30) ? 180 : 360)" />
          <Stroke color="[CONFIGURATION.palette.2]" thickness="3" cap="ROUND" />
        </Arc>
      </PartDraw>
    </Group>

    <!-- Hour: a lance cut from the board, shaded with swelling strokes. -->
    <Group x="0" y="0" width="450" height="450" name="hour" pivotX="0.5" pivotY="0.5">
      <Transform target="angle" value="(([HOUR_0_23] % 12) * 30 + [MINUTE] * 0.5)" />
      <PartImage x="0" y="0" width="450" height="450"><Image resource="crosshatch_hour_shadow" /></PartImage>
      <PartImage x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.palette.1]">
        <Variant mode="AMBIENT" target="alpha" value="190" />
        <Image resource="crosshatch_hour" />
      </PartImage>
    </Group>

    <!-- Minute: a hairline carved into the board, centre to rim. -->
    <Group x="0" y="0" width="450" height="450" name="minute" pivotX="0.5" pivotY="0.5">
      <Transform target="angle" value="([MINUTE] * 6 + [SECOND] * 0.1)" />
      <PartDraw x="0" y="0" width="450" height="450">
        <Line startX="225" startY="221" endX="225" endY="10">
          <Stroke color="#FF000000" thickness="6" cap="ROUND" />
        </Line>
        <Line startX="225" startY="219" endX="225" endY="12">
          <Stroke color="[CONFIGURATION.palette.1]" thickness="2" cap="ROUND" />
        </Line>
      </PartDraw>
      <!-- Nib: runs out along the line once a minute. -->
      <Group x="211" y="195" width="28" height="28" name="nib">
        <Transform target="y" value="211 - (16 + 190 * (([SECOND] + [MILLISECOND] / 1000) / 60))" />
        <Variant mode="AMBIENT" target="alpha" value="0" />
        <PartImage x="0" y="0" width="28" height="28" tintColor="[CONFIGURATION.palette.2]"><Image resource="crosshatch_nib" /></PartImage>
      </Group>
    </Group>

  </Scene>
</WatchFace>
